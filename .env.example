# Modelo de configuração. Copie para um arquivo chamado .env e troque os valores.
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux e macOS)
#
# O .env fica de fora do Git de propósito: ele guarda as senhas desta máquina.
# NUNCA escreva senhas reais neste arquivo de exemplo — ele vai para o repositório.
#
# ATENÇÃO AO CIFRÃO: o Docker trata "$" como início de uma variável e apaga o trecho
# seguinte. Uma senha "abc$def" chega à aplicação como "abc". Evite "$" nos valores
# abaixo; se precisar mesmo usar um, escreva dois seguidos: "abc$$def".

POSTGRES_DB=vetcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-sua
POSTGRES_PORT=5432

# Assina os cartões de acesso dos usuários. Precisa de no mínimo 32 caracteres e é
# obrigatória: sem ela a pilha não sobe. Invente uma frase longa em vez de sortear
# símbolos: é mais fácil e igualmente seguro.
JWT_CHAVE=troque-esta-frase-longa-por-outra-de-sua-escolha-2026

API_PORT=5265
WEB_PORT=8080

# Endereços que o navegador usa para alcançar cada serviço. Para abrir o portal pelo
# celular, troque "localhost" pelo IP do computador na rede (veja a Parte 5 do COMO-USAR).
# WEB_URL também é a base dos links enviados por e-mail (redefinição de senha etc.).
API_URL=http://localhost:5265
WEB_URL=http://localhost:8080

ASPNETCORE_ENVIRONMENT=Production

# Nome que assina os e-mails e fuso horário em que a clínica funciona.
NOME_DA_CLINICA=Clínica VetSPA
FUSO_HORARIO=America/Sao_Paulo

# ---------------------------------------------------------------------------
# E-mail (recuperação de senha, boas-vindas e notificações do tratamento)
#
# Deixe SMTP_HOST em branco para NÃO usar um servidor de e-mail: cada mensagem é
# gravada como um arquivo .html na pasta emails-enviados da API, que você pode abrir
# no navegador. Serve para desenvolver e demonstrar o sistema sem conta de e-mail.
#
# Para enviar de verdade, preencha com os dados do seu provedor. Exemplos:
#   Gmail:    smtp.gmail.com, porta 587, usuário = seu e-mail, senha = "senha de app"
#   Outlook:  smtp.office365.com, porta 587
#   Brevo:    smtp-relay.brevo.com, porta 587
#   SendGrid: smtp.sendgrid.net, porta 587, usuário "apikey", senha = chave da API
# ---------------------------------------------------------------------------
EMAIL_REMETENTE=nao-responda@vetcare.local
EMAIL_NOME_REMETENTE=VetCare
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_SEGURANCA=StartTls

# ---------------------------------------------------------------------------
# Notificações no celular do tutor (serviço de push da Expo)
#
# Funciona sem credencial. EXPO_ACCESS_TOKEN só é necessário se a opção
# "Enhanced Push Security" estiver ligada no painel da Expo.
# ---------------------------------------------------------------------------
PUSH_HABILITADO=true
EXPO_ACCESS_TOKEN=

# Conta de administrador criada quando o banco nasce vazio. Em branco, valem
# admin@vetcare.com / vetcare123 (troque no primeiro acesso).
ADMIN_EMAIL=
ADMIN_SENHA=

# Liga a documentação interativa da API (/scalar) mesmo em produção.
API_DOCS=false
