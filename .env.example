# Modelo de configuração. Copie para um arquivo chamado .env e troque os valores.
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux e macOS)
#
# O .env fica de fora do Git de propósito: ele guarda as senhas desta máquina.
# NUNCA escreva senhas reais neste arquivo de exemplo — ele vai para o repositório.
#
# ATENÇÃO AO CIFRÃO: o Docker trata "$" como início de uma variável e apaga o trecho
# seguinte. Uma senha "abc$def" chega à aplicação como "abc". Evite "$" nos valores
# abaixo; se precisar mesmo usar um, escreva dois seguidos: "abc$$def".

POSTGRES_DB=vetcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-sua
POSTGRES_PORT=5432

# Assina os cartões de acesso dos usuários. Precisa de no mínimo 32 caracteres.
# Invente uma frase longa em vez de sortear símbolos: é mais fácil e igualmente seguro.
JWT_CHAVE=troque-esta-frase-longa-por-outra-de-sua-escolha-2026

API_PORT=5265
WEB_PORT=8080

# Endereços que o navegador usa para alcançar cada serviço. Para abrir o portal pelo
# celular, troque "localhost" pelo IP do computador na rede (veja a Parte 5 do COMO-USAR).
API_URL=http://localhost:5265
WEB_URL=http://localhost:8080

ASPNETCORE_ENVIRONMENT=Production
