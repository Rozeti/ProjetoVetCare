###############################################################################
# VetCare — requisições de referência da API.
# Rode a API (dotnet run) e execute na ordem: o login preenche a variável @token
# usada pelas demais requisições.
###############################################################################

@host = http://localhost:5265

# Datas relativas: o cliente REST calcula no momento da execução, então o arquivo não
# envelhece. A sessão é marcada para daqui a 7 dias às 14h (dentro do expediente padrão).
@diaDaSessao = {{$datetime "YYYY-MM-DD" 7 d}}
@diaDaAplicacao = {{$datetime "YYYY-MM-DD" -10 d}}
@proximaDose = {{$datetime "YYYY-MM-DD" 20 d}}

### Health check (não exige autenticação)
GET {{host}}/health

### HU-001 — Login
# @name login
POST {{host}}/api/usuarios/login
Content-Type: application/json

{
  "email": "admin@vetcare.com",
  "senha": "vetcare123"
}

@token = {{login.response.body.token}}

### HU-001, CA-2 — Credenciais inválidas devolvem mensagem genérica (401)
POST {{host}}/api/usuarios/login
Content-Type: application/json

{
  "email": "admin@vetcare.com",
  "senha": "senha-errada"
}

### Dados do usuário autenticado
GET {{host}}/api/usuarios/me
Authorization: Bearer {{token}}

### RNF-002 — Sem token o acesso é negado (401)
GET {{host}}/api/pets

###############################################################################
# HU-002 — Gestão de usuários (somente Administrador)
###############################################################################

### Listar usuários
GET {{host}}/api/usuarios
Authorization: Bearer {{token}}

### Cadastrar veterinário (cria também o registro profissional)
# @name novoVeterinario
POST {{host}}/api/usuarios
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Dr. Rafael Nunes",
  "email": "rafael@vetcare.com",
  "senha": "senha123",
  "perfil": "Veterinario",
  "crmv": "CRMV-DF 55110",
  "especialidade": "Fisioterapia veterinária"
}

@veterinarioId = {{novoVeterinario.response.body.veterinarioId}}

### RN-007 — E-mail duplicado é bloqueado (409)
POST {{host}}/api/usuarios
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Duplicado Souza",
  "email": "rafael@vetcare.com",
  "senha": "senha123",
  "perfil": "Veterinario",
  "crmv": "CRMV-DF 99999"
}

### Validação: nome sem sobrenome, CRMV sem UF válida e senha sem números são recusados (400)
POST {{host}}/api/usuarios
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Rafael",
  "email": "rafael2@vetcare.com",
  "senha": "somenteletras",
  "perfil": "Veterinario",
  "crmv": "CRMV-XX 1"
}

### Tutores não são cadastrados em /api/usuarios (400): use /api/tutores
POST {{host}}/api/usuarios
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Joana Prado",
  "email": "joana@vetcare.com",
  "perfil": "Tutor"
}

### Cadastrar tutor (cria também o acesso; telefone com DDD obrigatório, CPF opcional e conferido)
# @name novoTutor
POST {{host}}/api/tutores
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Joana Prado",
  "email": "joana@vetcare.com",
  "senha": "senha123",
  "telefone": "61988887777",
  "cpf": "123.456.789-09",
  "endereco": "Taguatinga, Brasília - DF"
}

@tutorId = {{novoTutor.response.body.id}}
@usuarioTutorId = {{novoTutor.response.body.usuarioId}}

### Editar tutor: a equipe altera nome, e-mail, telefone, CPF e endereço; o próprio tutor, só o contato
PUT {{host}}/api/tutores/{{tutorId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Joana Prado Lima",
  "telefone": "(61) 3333-4444"
}

### HU-002, CA-5 — Redefinir senha (devolve a senha provisória)
POST {{host}}/api/usuarios/{{usuarioTutorId}}/redefinir-senha
Authorization: Bearer {{token}}

### HU-002, CA-4 — Desativar conta (impede acesso sem excluir dados)
PATCH {{host}}/api/usuarios/{{usuarioTutorId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{ "ativo": false }

### Reativar conta
PATCH {{host}}/api/usuarios/{{usuarioTutorId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{ "ativo": true }

###############################################################################
# HU-003 — Pacientes
###############################################################################

### Cadastrar paciente
# @name novoPet
POST {{host}}/api/pets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Mel",
  "especie": "Cachorro",
  "raca": "Beagle",
  "sexo": "Fêmea",
  "dataNascimento": "2020-08-30",
  "pesoAtualKg": 12.4,
  "tutorId": "{{tutorId}}",
  "veterinarioResponsavelId": "{{veterinarioId}}"
}

@pacienteId = {{novoPet.response.body.id}}

### RN-001 — Paciente sem tutor é recusado (400)
POST {{host}}/api/pets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Sem tutor",
  "especie": "Cachorro",
  "dataNascimento": "2021-01-10",
  "tutorId": "00000000-0000-0000-0000-000000000000"
}

### Listar pacientes (aceita busca e filtros por status e raça)
GET {{host}}/api/pets?busca=Mel&ativo=true&raca=Poodle
Authorization: Bearer {{token}}

### Raças dos pacientes, para o filtro da lista
GET {{host}}/api/pets/racas
Authorization: Bearer {{token}}

### Inativar paciente (pacientes não são excluídos; o prontuário é preservado)
PATCH {{host}}/api/pets/{{pacienteId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{ "ativo": false }

### Reativar paciente
PATCH {{host}}/api/pets/{{pacienteId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{ "ativo": true }

###############################################################################
# Fluxo clínico: animal → avaliações → tratamentos → sessões registradas (HU-007 / HU-008)
# Na interface, o registro de cada sessão realizada se chama "sessão"; na API ele continua
# sendo o atendimento (/api/atendimentos), a evolução do requisito HU-008.
###############################################################################

### RN-010 — Avaliação com campo obrigatório vazio é recusada (400)
POST {{host}}/api/avaliacoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "motivoConsulta": "Dificuldade para levantar",
  "observacoes": "",
  "diagnosticoPossivel": "Displasia coxofemoral"
}

### HU-007, CA-1 — Avaliação: motivo da consulta, observações, possível diagnóstico e veterinário
# @name novaAvaliacao
POST {{host}}/api/avaliacoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "veterinarioId": "{{veterinarioId}}",
  "motivoConsulta": "Dificuldade para levantar após repouso.",
  "observacoes": "Quadro progressivo nos últimos seis meses. Dor à extensão do quadril, massa muscular reduzida.",
  "diagnosticoPossivel": "Displasia coxofemoral bilateral.",
  "observacaoInterna": "Tutora demonstra dificuldade em seguir as orientações."
}

@avaliacaoId = {{novaAvaliacao.response.body.id}}

### RN-004 — Corrigir a avaliação (a versão anterior é arquivada)
PUT {{host}}/api/avaliacoes/{{avaliacaoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "motivoConsulta": "Dificuldade para levantar após repouso prolongado.",
  "observacoes": "Quadro progressivo nos últimos seis meses. Dor à extensão do quadril, massa muscular reduzida.",
  "diagnosticoPossivel": "Displasia coxofemoral bilateral."
}

### RN-004 — Histórico de versões do registro
GET {{host}}/api/avaliacoes/{{avaliacaoId}}/historico
Authorization: Bearer {{token}}

### Avaliações do animal, cada uma com os tratamentos, receitas e pedidos de exame que originou
GET {{host}}/api/avaliacoes/paciente/{{pacienteId}}
Authorization: Bearer {{token}}

### Tratamento sem avaliação de origem é recusado (404)
POST {{host}}/api/tratamentos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Tratamento sem origem",
  "tipo": "Fisioterapia",
  "descricao": "Teste",
  "duracaoPrevista": "1 mês",
  "frequencia": "Semanal",
  "sessoesPrevistas": 4
}

### Tratamento encaminhado a partir da avaliação (status Planejado, o padrão, ou Em Andamento)
# @name novoTratamento
POST {{host}}/api/tratamentos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "avaliacaoId": "{{avaliacaoId}}",
  "veterinarioId": "{{veterinarioId}}",
  "nome": "Reabilitação de displasia coxofemoral",
  "tipo": "Fisioterapia",
  "descricao": "Hidroterapia e fortalecimento muscular para reduzir a dor e melhorar a marcha.",
  "duracaoPrevista": "12 semanas",
  "frequencia": "2 sessões por semana",
  "sessoesPrevistas": 24,
  "status": "Planejado",
  "observacoesGerais": "Tutora orientada sobre controle de peso."
}

@tratamentoId = {{novoTratamento.response.body.id}}

### HU-004, CA-1 — Agendar sessão (nasce Aguardando confirmação)
# @name novaSessao
POST {{host}}/api/sessoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tratamentoId": "{{tratamentoId}}",
  "veterinarioId": "{{veterinarioId}}",
  "dataHora": "{{diaDaSessao}}T14:00:00",
  "observacoes": "Trazer o pet em jejum de duas horas."
}

@sessaoId = {{novaSessao.response.body.id}}

### RN-002 — Conflito de horário no mesmo veterinário (409)
POST {{host}}/api/sessoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tratamentoId": "{{tratamentoId}}",
  "veterinarioId": "{{veterinarioId}}",
  "dataHora": "{{diaDaSessao}}T14:00:00"
}

### HU-004, CA-5 — Agendamento retroativo é bloqueado (400)
POST {{host}}/api/sessoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tratamentoId": "{{tratamentoId}}",
  "veterinarioId": "{{veterinarioId}}",
  "dataHora": "2020-01-10T09:00:00"
}

### HU-004, CA-3 — Agenda do veterinário (visao = dia | semana | mes)
GET {{host}}/api/sessoes/agenda/{{veterinarioId}}?data={{diaDaSessao}}&visao=semana
Authorization: Bearer {{token}}

### HU-005 — Agenda geral consolidada da clínica
GET {{host}}/api/sessoes/agenda-geral?data={{diaDaSessao}}&visao=dia
Authorization: Bearer {{token}}

### HU-006 — Confirmar presença
PATCH {{host}}/api/sessoes/{{sessaoId}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{ "status": "Confirmada" }

### HU-008, CA-2 — Escala de dor fora do intervalo 0–10 é recusada (400)
POST {{host}}/api/atendimentos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "sessaoId": "{{sessaoId}}",
  "tecnicasAplicadas": "Hidroterapia",
  "escalaDor": 15,
  "evolucaoClinica": "Teste",
  "reacaoAnimal": "Teste"
}

### HU-008, CA-1 — Registro da sessão realizada (o número é atribuído pela API; a primeira põe o tratamento em andamento)
# @name novaEvolucao
POST {{host}}/api/atendimentos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "sessaoId": "{{sessaoId}}",
  "veterinarioId": "{{veterinarioId}}",
  "tecnicasAplicadas": "Hidroterapia, Laserterapia, Cinesioterapia",
  "escalaDor": 4,
  "evolucaoClinica": "Esteira aquática por 15 minutos e exercícios de transição deitado-em pé.",
  "reacaoAnimal": "Tolerou bem a água; cansou no fim da sessão.",
  "observacoes": "Melhora na transição deitado-em pé.",
  "relatorio": "Primeira sessão do protocolo, sem intercorrências.",
  "proximosPassos": "Manter o protocolo por mais quatro semanas.",
  "pesoKg": 12.1,
  "temperaturaCelsius": 38.2,
  "frequenciaCardiaca": 88,
  "frequenciaRespiratoria": 22,
  "observacaoInterna": "Avaliar encaminhamento ortopédico se não houver ganho."
}

@evolucaoId = {{novaEvolucao.response.body.id}}

### Sessões registradas, com filtros (pacienteId, tratamentoId, inicio, fim, veterinarioId, numeroSessao); por tratamento saem em ordem cronológica
GET {{host}}/api/atendimentos?pacienteId={{pacienteId}}&tratamentoId={{tratamentoId}}&pagina=1&tamanho=20
Authorization: Bearer {{token}}

### Sessão realizada sem agendamento: o registro nasce do tratamento, e a API cria a sessão já concluída
POST {{host}}/api/atendimentos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tratamentoId": "{{tratamentoId}}",
  "veterinarioId": "{{veterinarioId}}",
  "tecnicasAplicadas": "Cinesioterapia",
  "escalaDor": 3,
  "evolucaoClinica": "Exercícios de propriocepção e alongamento.",
  "reacaoAnimal": "Colaborativo durante toda a sessão."
}

### Receita emitida a partir da sessão registrada (a origem é obrigatória: avaliacaoId ou atendimentoId)
POST {{host}}/api/prescricoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "veterinarioId": "{{veterinarioId}}",
  "atendimentoId": "{{evolucaoId}}",
  "itens": [
    { "medicamento": "Gabapentina 100 mg", "dosagem": "1 cápsula", "frequencia": "a cada 12 horas", "duracao": "por 7 dias", "via": "Oral" }
  ]
}

### Pedido de exames a partir da avaliação (um exame por linha)
# @name novoPedidoExame
POST {{host}}/api/pedidos-exame
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "avaliacaoId": "{{avaliacaoId}}",
  "exames": "Raio-X do quadril em duas incidências\nHemograma completo",
  "justificativa": "Confirmar a displasia antes de ampliar o protocolo."
}

@pedidoExameId = {{novoPedidoExame.response.body.id}}

### Pedidos de exame do animal
GET {{host}}/api/pedidos-exame/paciente/{{pacienteId}}
Authorization: Bearer {{token}}

### Editar o pedido de exame (a versão anterior fica guardada; a avaliação de origem pode mudar, desde que do mesmo animal)
PUT {{host}}/api/pedidos-exame/{{pedidoExameId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "avaliacaoId": "{{avaliacaoId}}",
  "exames": "Raio-X do quadril em duas incidências\nHemograma completo\nPerfil bioquímico",
  "justificativa": "Confirmar a displasia antes de ampliar o protocolo."
}

### Excluir o pedido de exame: ele sai do prontuário, e a auditoria registra a exclusão
DELETE {{host}}/api/pedidos-exame/{{pedidoExameId}}
Authorization: Bearer {{token}}

### Atualizar o tratamento (campos omitidos mantêm o valor atual)
PUT {{host}}/api/tratamentos/{{tratamentoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "frequencia": "3 sessões por semana",
  "sessoesPrevistas": 30
}

### Inativar o tratamento: as sessões registradas continuam no histórico, e ele pode ser reativado
PUT {{host}}/api/tratamentos/{{tratamentoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "status": "Inativado" }

### Reativar o tratamento (Concluído, ao contrário, é definitivo)
PUT {{host}}/api/tratamentos/{{tratamentoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "status": "Em Andamento" }

### HU-009 — Observações internas do paciente (rota fechada ao Tutor)
GET {{host}}/api/observacoes-internas/paciente/{{pacienteId}}
Authorization: Bearer {{token}}

###############################################################################
# HU-011 / HU-012 — Prontuário e documentos
###############################################################################

### HU-011 — Prontuário completo (avaliações, tratamentos, linha do tempo com categorias, receitas, exames, documentos)
GET {{host}}/api/prontuarios/paciente/{{pacienteId}}
Authorization: Bearer {{token}}

### HU-012 — Documentos do paciente
GET {{host}}/api/documentos/paciente/{{pacienteId}}
Authorization: Bearer {{token}}

###############################################################################
# HU-014 / HU-015 / HU-016
###############################################################################

### Conversas do usuário autenticado
GET {{host}}/api/mensagens/conversas
Authorization: Bearer {{token}}

### Notificações
GET {{host}}/api/notificacoes
Authorization: Bearer {{token}}

### HU-016 — Indicadores do dia (escopo definido pela RN-008)
GET {{host}}/api/dashboard/indicadores
Authorization: Bearer {{token}}

### Configurações da clínica (RN-002 e RN-009 usam estes valores)
GET {{host}}/api/clinica
Authorization: Bearer {{token}}

###############################################################################
# Carteira de vacinação, alertas clínicos, receituário, bloqueios e auditoria
###############################################################################

### Alerta clínico (alergia, comorbidade, restrição ou cirurgia) — visível também ao tutor
POST {{host}}/api/alergias
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "tipo": "Alergia",
  "descricao": "Alergia a dipirona, com histórico de reação cutânea.",
  "gravidade": "Grave"
}

### Carteira — dose 1 de um esquema de 3 doses (a próxima dose é obrigatória enquanto o esquema está em aberto)
# @name dose1
POST {{host}}/api/vacinas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "tipo": "Vacina",
  "nome": "V10",
  "fabricante": "Zoetis",
  "lote": "A2291",
  "numeroDose": 1,
  "totalDoses": 3,
  "dataAplicacao": "{{diaDaAplicacao}}",
  "proximaDose": "{{proximaDose}}"
}

@vacinaId = {{dose1.response.body.id}}

### Carteira — dose 3 antes da dose 2 é recusada (400): a sequência do esquema é conferida
POST {{host}}/api/vacinas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "tipo": "Vacina",
  "nome": "V10",
  "numeroDose": 3,
  "totalDoses": 3,
  "dataAplicacao": "{{diaDaAplicacao}}"
}

### Carteira — recorrência calcula a próxima dose quando a data não é informada (Mensal, Trimestral, Semestral, Anual)
POST {{host}}/api/vacinas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "tipo": "Antipulgas",
  "nome": "Antipulgas mensal",
  "recorrencia": "Mensal",
  "dataAplicacao": "{{diaDaAplicacao}}"
}

### Carteira paginada e filtrada (tipo, situacao = Em dia | A vencer | Vencida | Dose única | Concluída, busca)
GET {{host}}/api/vacinas/paciente/{{pacienteId}}?situacao=Em dia&pagina=1&tamanho=10
Authorization: Bearer {{token}}

### Painel de prevenção: doses vencidas ou a vencer nos próximos 30 dias (equipe clínica)
GET {{host}}/api/vacinas/vencendo?dias=30
Authorization: Bearer {{token}}

### Carteira — correção de um registro (quem aplicou, lote, datas)
PUT {{host}}/api/vacinas/{{vacinaId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tipo": "Vacina",
  "nome": "V10",
  "fabricante": "Zoetis",
  "lote": "A2291-B",
  "numeroDose": 1,
  "totalDoses": 3,
  "dataAplicacao": "{{diaDaAplicacao}}",
  "proximaDose": "{{proximaDose}}"
}

### Carteira — exclusão exige justificativa (fica na auditoria); sem ela a API responde 400
DELETE {{host}}/api/vacinas/{{vacinaId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "justificativa": "Lançada na carteira do paciente errado."
}

### Receita com dois medicamentos, a partir da avaliação (o veterinário logado assina; o administrador informa veterinarioId)
# @name novaReceita
POST {{host}}/api/prescricoes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "pacienteId": "{{pacienteId}}",
  "veterinarioId": "{{veterinarioId}}",
  "avaliacaoId": "{{avaliacaoId}}",
  "orientacoes": "Administrar junto com alimento.",
  "itens": [
    { "medicamento": "Meloxicam 2 mg", "dosagem": "1 comprimido", "frequencia": "a cada 24 horas", "duracao": "por 5 dias", "via": "Oral" },
    { "medicamento": "Condroitina 500 mg", "dosagem": "1 cápsula", "frequencia": "a cada 12 horas", "duracao": "uso contínuo", "via": "Oral" }
  ]
}

@prescricaoId = {{novaReceita.response.body.id}}

### RN-004 — A receita é cancelada, nunca apagada; o motivo fica no histórico e na auditoria
PATCH {{host}}/api/prescricoes/{{prescricaoId}}/cancelar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "motivo": "Dosagem revista após retorno."
}

### Bloqueio de agenda do veterinário (férias, congresso): sessões no período são recusadas
POST {{host}}/api/bloqueios-agenda
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "veterinarioId": "{{veterinarioId}}",
  "inicio": "{{$datetime "YYYY-MM-DD" 30 d}}T08:00:00",
  "fim": "{{$datetime "YYYY-MM-DD" 35 d}}T18:00:00",
  "motivo": "Congresso de fisioterapia"
}

### Pacientes ativos para os seletores dos formulários (sem paginação; a equipe vê toda a clínica, o tutor só os seus)
GET {{host}}/api/pets/selecao
Authorization: Bearer {{token}}

### Trocar o veterinário responsável na edição do cadastro (não há mais transferência:
### qualquer veterinário atende qualquer paciente; tratamentos e sessões não mudam)
PUT {{host}}/api/pets/{{pacienteId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Mel",
  "especie": "Cachorro",
  "raca": "Beagle",
  "sexo": "Fêmea",
  "dataNascimento": "2020-08-30",
  "tutorId": "{{tutorId}}",
  "veterinarioResponsavelId": "{{veterinarioId}}"
}

### Trilha de auditoria: só criações, alterações, inativações e exclusões (filtros: acao, entidade, usuarioId, inicio, fim; paginada)
GET {{host}}/api/auditoria?entidade=Vacina&pagina=1&tamanho=25
Authorization: Bearer {{token}}

### Configurações da clínica — alterar expediente e prazo de cancelamento (RN-009)
PUT {{host}}/api/clinica
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nome": "Clínica VetSPA",
